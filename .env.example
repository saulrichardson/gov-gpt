# === Gov GPT environment template ===

# Live API host used by MCP calls and semantic endpoint artifacts.
USASPENDING_BASE_URL=https://api.usaspending.gov

# OpenAI Agents SDK.
# CODEX_API_KEY is accepted as a local fallback alias by scripts/agents/src/env.ts.
OPENAI_API_KEY=
CODEX_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Optional MCP request timeout override in milliseconds.
USASPENDING_REQUEST_TIMEOUT_MS=15000
